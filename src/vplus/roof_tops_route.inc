#define SROOF_GRP GA(0x801A9848u)            /* worldSectionGrpFile, 6036 bytes */
static void sroof_route_write(void)
{
    CPU *cpu = &M.cpu;
    /* route points: the whole 140-point array (unused ones zero), then the count */
    for (uint32_t i = 0; i < 140; i++) {
        uint32_t a = GA(0x801B1DE8u) + 24u * i;
        for (uint32_t k = 0; k < 24; k += 4) mem_w32(cpu, a + k, 0);
        if (i >= SROOF_NODES) continue;
        const SroofNode *n = &sroof_nodes[i];
        mem_w32(cpu, a + 0x00, (uint32_t)n->x);
        mem_w32(cpu, a + 0x04, (uint32_t)n->y);
        mem_w16(cpu, a + 0x08, (uint16_t)n->z);
        for (uint32_t k = 0; k < 4; k++) {
            mem_w16(cpu, a + 0x0A + 2u * k, (uint16_t)n->next[k]);
            mem_w8(cpu, a + 0x12 + k, (uint8_t)n->lane[k]);
        }
        mem_w8(cpu, a + 0x16, n->count);
        mem_w8(cpu, a + 0x17, n->section);
    }
    mem_w32(cpu, GA(0x80180AD8u), SROOF_NODES);  /* aiRouteNodeCount */
    /* start points: startNodeList s16[15] 801B2B28, taken flags u8[15] 801B2B46, count 801B2B55 */
    for (uint32_t i = 0; i < 15; i++) {
        mem_w16(cpu, GA(0x801B2B28u) + 2u * i, (uint16_t)(i < SROOF_STARTS ? sroof_starts[i] : 0));
        mem_w8(cpu, GA(0x801B2B46u) + i, 0);
    }
    mem_w8(cpu, GA(0x801B2B55u), SROOF_STARTS);
    /* route tables: rows 0..12, columns 0..13 (row 13, the street itself, keeps retail -1 / 0) */
    for (uint32_t s = 0; s < SROOF_TSEC; s++)
        for (uint32_t t = 0; t <= SROOF_TSEC; t++) {
            mem_w8(cpu, SROOF_GRP + 0x354 + 35u * s + t, (uint8_t)sroof_next_node[s][t]);   /* next node */
            mem_w8(cpu, SROOF_GRP + 0x81D + 35u * s + t, (uint8_t)sroof_next_section[s][t]); /* next section */
        }
    for (uint32_t k = 0; k < sizeof sroof_speed / sizeof sroof_speed[0]; k++)
        mem_w8(cpu, SROOF_GRP + 0x1281 + 35u * sroof_speed[k][0] + sroof_speed[k][1], sroof_speed[k][2]); /* speed table */
}
