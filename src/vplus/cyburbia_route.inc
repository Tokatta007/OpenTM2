#define CYB_GRP GA(0x801A9848u)              /* worldSectionGrpFile, 6036 bytes */
static void cyb_route_write(void)
{
    CPU *cpu = &M.cpu;
    /* route points: the whole 140-point array (unused ones zero), then the count */
    for (uint32_t i = 0; i < 140; i++) {
        uint32_t a = GA(0x801B1DE8u) + 24u * i;
        for (uint32_t k = 0; k < 24; k += 4) mem_w32(cpu, a + k, 0);
        if (i >= CYB_NODES) continue;
        const CybNode *n = &cyb_nodes[i];
        mem_w32(cpu, a + 0x00, (uint32_t)n->x);
        mem_w32(cpu, a + 0x04, (uint32_t)n->y);
        mem_w16(cpu, a + 0x08, (uint16_t)n->z);
        for (uint32_t k = 0; k < 4; k++) {
            mem_w16(cpu, a + 0x0A + 2u * k, (uint16_t)n->next[k]);
            mem_w8(cpu, a + 0x12 + k, (uint8_t)n->lane[k]);
        }
        mem_w8(cpu, a + 0x16, n->count);
        mem_w8(cpu, a + 0x17, n->section);
    }
    mem_w32(cpu, GA(0x80180AD8u), CYB_NODES);   /* aiRouteNodeCount */
    /* start points: startNodeList s16[15] 801B2B28, taken flags u8[15] 801B2B46, count 801B2B55 */
    for (uint32_t i = 0; i < 15; i++) {
        mem_w16(cpu, GA(0x801B2B28u) + 2u * i, (uint16_t)(i < CYB_STARTS ? cyb_starts[i] : 0));
        mem_w8(cpu, GA(0x801B2B46u) + i, 0);
    }
    mem_w8(cpu, GA(0x801B2B55u), CYB_STARTS);
    /* sections: all 35 slots rewritten (unused ones zero, like the retail file past its count) */
    for (uint32_t s = 0; s < 35; s++) {
        int u = s < CYB_SECTIONS;
        const CybSection *c = &cyb_sections[u ? s : 0];
        mem_w32(cpu, CYB_GRP + 0x0C + 12u * s, u ? (uint32_t)c->x : 0);       /* box x */
        mem_w32(cpu, CYB_GRP + 0x10 + 12u * s, u ? (uint32_t)c->y : 0);       /* box y */
        mem_w32(cpu, CYB_GRP + 0x14 + 12u * s, 0);                             /* floor height */
        mem_w32(cpu, CYB_GRP + 0x1B0 + 4u * s, u ? (uint32_t)c->w : 0);        /* width (x) */
        mem_w32(cpu, CYB_GRP + 0x23C + 4u * s, u ? (uint32_t)c->l : 0);        /* depth (y) */
        mem_w16(cpu, CYB_GRP + 0x2C8 + 2u * s, 0);                             /* sn */
        mem_w16(cpu, CYB_GRP + 0x30E + 2u * s, u ? 4096 : 0);                  /* cs */
        mem_w8(cpu, CYB_GRP + 0x11AF + s, u ? 0x57 : 0);                      /* aiRouteFollowRanges */
        mem_w8(cpu, CYB_GRP + 0x11D2 + s, 0);                                  /* rotated */
        mem_w8(cpu, CYB_GRP + 0x11F5 + s, u ? 1 : 0);                          /* hasFloor */
        mem_w8(cpu, CYB_GRP + 0x1218 + s, 0);                                  /* hasDrop */
        mem_w8(cpu, CYB_GRP + 0x123B + s, 0);                                  /* shape: box */
        mem_w8(cpu, CYB_GRP + 0x125E + s, 0);                                  /* ground class */
        mem_w8(cpu, CYB_GRP + 0x174A + s, u ? c->first_surface : 0);           /* first surface */
        mem_w8(cpu, CYB_GRP + 0x176D + s, u ? c->last_surface : 0);            /* last surface */
        for (uint32_t t = 0; t < 35; t++) {
            int v = u && t < CYB_SECTIONS;
            mem_w8(cpu, CYB_GRP + 0x354 + 35u * s + t, v ? (uint8_t)cyb_next_node[s][t] : 0xFF);   /* next node */
            mem_w8(cpu, CYB_GRP + 0x81D + 35u * s + t, v ? (uint8_t)cyb_next_section[s][t] : 0);  /* next section */
            mem_w8(cpu, CYB_GRP + 0xCE6 + 35u * s + t, 0);                     /* link table: off */
            mem_w8(cpu, CYB_GRP + 0x1281 + 35u * s + t, 0);                    /* speed limit: none */
        }
    }
    mem_w8(cpu, CYB_GRP + 0x1790, CYB_SECTIONS);    /* the count worldSectionAt reads */
    mem_w32(cpu, GA(0x80180AD4u), CYB_SECTIONS);    /* terrainSectionCount (written by the loader, not read) */
}
