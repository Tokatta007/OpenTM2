 // a larger picture over a rectangle of the upscaled VRAM (Psyz_VideoLoadImageHD)
+static void HdCount(void) {
+    Uint32 n = 0;
+    for (Uint32 i = 0; i < HD_SLOTS; i++) {
+        if (hd_block.rect[i][2] > hd_block.rect[i][0]) {
+            n = i + 1;
+        }
+    }
+    hd_block.count[0] = n;
+}
+
+int Psyz_VideoSetTextureHD(int slot, int page_x, int page_y, int clut, int u0, int v0, int u1, int v1,
+                           const unsigned char* rgba, int w, int h) {
+    if (slot < 0 || slot >= HD_SLOTS || !hd_atlas || !rgba || w <= 0 || h <= 0 || w > HD_CELL ||
+        h > HD_CELL || u1 <= u0 || v1 <= v0) {
+        return 0;
+    }
+    const Uint32 size = (Uint32)(w * h * 4);
+    if (!hd_atlas_xfer[slot] || hd_atlas_xfer_size[slot] < size) {
+        if (hd_atlas_xfer[slot]) {
+            SDL_ReleaseGPUTransferBuffer(device, hd_atlas_xfer[slot]);
+        }
+        const SDL_GPUTransferBufferCreateInfo xfer_info = {
+            .usage = SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD,
+            .size = size,
+        };
+        hd_atlas_xfer[slot] = SDL_CreateGPUTransferBuffer(device, &xfer_info);
+        hd_atlas_xfer_size[slot] = hd_atlas_xfer[slot] ? size : 0;
+        if (!hd_atlas_xfer[slot]) {
+            return 0;
+        }
+    }
+    SDL_GPUCommandBuffer* cmd = AcquireCmd();
+    if (!cmd) {
+        return 0;
+    }
+    u8* map = SDL_MapGPUTransferBuffer(device, hd_atlas_xfer[slot], true);
+    if (!map) {
+        return 0;
+    }
+    memcpy(map, rgba, (size_t)w * h * 4);
+    SDL_UnmapGPUTransferBuffer(device, hd_atlas_xfer[slot]);
+    const int cx = (slot % 4) * HD_CELL, cy = (slot / 4) * HD_CELL;
+    SDL_GPUCopyPass* copy = SDL_BeginGPUCopyPass(cmd);
+    const SDL_GPUTextureTransferInfo src = {
+        .transfer_buffer = hd_atlas_xfer[slot],
+        .pixels_per_row = (Uint32)w,
+        .rows_per_layer = (Uint32)h,
+    };
+    const SDL_GPUTextureRegion dst = {
+        .texture = hd_atlas, .x = (Uint32)cx, .y = (Uint32)cy, .w = (Uint32)w, .h = (Uint32)h, .d = 1};
+    // not cycled: the atlas keeps the other slots' pictures
+    SDL_UploadToGPUTexture(copy, &src, &dst, false);
+    SDL_EndGPUCopyPass(copy);
+    hd_block.key[slot][0] = (Uint32)page_x;
+    hd_block.key[slot][1] = (Uint32)page_y;
+    hd_block.key[slot][2] = clut < 0 ? 0 : (Uint32)clut;
+    hd_block.key[slot][3] = clut < 0 ? 0 : 1;
+    hd_block.rect[slot][0] = (Uint32)u0;
+    hd_block.rect[slot][1] = (Uint32)v0;
+    hd_block.rect[slot][2] = (Uint32)u1;
+    hd_block.rect[slot][3] = (Uint32)v1;
+    // half a texel in from the picture's edges: the filter never reaches the next cell
+    hd_block.atlas[slot][0] = (cx + 0.5f) / HD_ATLAS;
+    hd_block.atlas[slot][1] = (cy + 0.5f) / HD_ATLAS;
+    hd_block.atlas[slot][2] = (w - 1.0f) / HD_ATLAS;
+    hd_block.atlas[slot][3] = (h - 1.0f) / HD_ATLAS;
+    HdCount();
+    return 1;
+}
+
+void Psyz_VideoClearTextureHD(int slot) {
+    if (slot < 0 || slot >= HD_SLOTS) {
+        return;
+    }
+    memset(hd_block.key[slot], 0, sizeof(hd_block.key[slot]));
+    memset(hd_block.rect[slot], 0, sizeof(hd_block.rect[slot]));
+    memset(hd_block.atlas[slot], 0, sizeof(hd_block.atlas[slot]));
+    HdCount();
+}
