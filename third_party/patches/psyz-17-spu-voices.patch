+ * and nothing else (volumes, reverb and the rest stay the main SPU's).
+ */
+#define PSYZ_SPU_EXT_VOICES 24
+#define PSYZ_SPU_ALL_VOICES (PSYZ_SPU_NUM_VOICES + PSYZ_SPU_EXT_VOICES)
