+
+void Psyz_SpuWriteExt(unsigned int reg_offset, unsigned short value) {
+    if (reg_offset >= sizeof(SPU_RXX) || (reg_offset & 1))
+        return;
+    spu_ext.raw[reg_offset >> 1] = value;
+    const int base = PSYZ_SPU_NUM_VOICES;
+    if (reg_offset == offsetof(SPU_RXX, key_on[0])) {
+        for (int v = 0; v < 16; v++)
+            if (value & (1u << v))
+                spu_key_on_voice(base + v);
+    } else if (reg_offset == offsetof(SPU_RXX, key_on[1])) {
+        for (int v = 0; v < 8; v++)
+            if (value & (1u << v))
+                spu_key_on_voice(base + 16 + v);
+    } else if (reg_offset == offsetof(SPU_RXX, key_off[0])) {
+        for (int v = 0; v < 16; v++)
+            if (value & (1u << v))
+                spu.voice[base + v].key_off = 1;
+    } else if (reg_offset == offsetof(SPU_RXX, key_off[1])) {
+        for (int v = 0; v < 8; v++)
+            if (value & (1u << v))
+                spu.voice[base + 16 + v].key_off = 1;
+    }
+}
+
+unsigned short Psyz_SpuReadExt(unsigned int reg_offset) {
+    if (reg_offset >= sizeof(SPU_RXX) || (reg_offset & 1))
+        return 0;
+    return spu_ext.raw[reg_offset >> 1];
 }
 
