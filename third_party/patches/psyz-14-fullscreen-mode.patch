+void Psyz_VideoSetFullscreenMode(int w, int h, float hz) {
+    if (w <= 0 || h <= 0) {
+        w = h = 0;
+        hz = 0;
+    }
+    if (w == fullscreen_w && h == fullscreen_h && hz == fullscreen_hz) {
+        return;
+    }
+    fullscreen_w = w;
+    fullscreen_h = h;
+    fullscreen_hz = hz;
+    if (window_mode == 2 && window_shown) { // through a window, as between fullscreen kinds
+        window_mode = 0;
+        ApplyWindowMode();
+        window_mode = 2;
+        ApplyWindowMode();
+    }
+}
