diff --git a/src/gpu/d3d12/SDL_gpu_d3d12.c b/src/gpu/d3d12/SDL_gpu_d3d12.c
index 43015c820..f285ae6f3 100644
--- a/src/gpu/d3d12/SDL_gpu_d3d12.c
+++ b/src/gpu/d3d12/SDL_gpu_d3d12.c
@@ -2417,6 +2417,9 @@ static D3D12DescriptorHeap *D3D12_INTERNAL_AcquireGPUDescriptorHeapFromPool(
     }
     SDL_UnlockMutex(pool->lock);
 
+    if (result == NULL) { /* (OpenTM2: the driver refused a new heap; the caller keeps the ones it has) */
+        return NULL;
+    }
     D3D12_INTERNAL_TrackGPUDescriptorHeap(commandBuffer, result);
     return result;
 }
@@ -5018,6 +5021,22 @@ static void D3D12_INTERNAL_SetGPUDescriptorHeaps(D3D12CommandBuffer *commandBuff
     viewHeap = D3D12_INTERNAL_AcquireGPUDescriptorHeapFromPool(commandBuffer, D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
     samplerHeap = D3D12_INTERNAL_AcquireGPUDescriptorHeapFromPool(commandBuffer, D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER);
 
+    /* (OpenTM2) No new heap from the driver (Intel graphics, low memory): keep writing in the ones bound, from their
+     * start. Earlier draws of this command buffer may show these descriptors, which beats reading a null heap. */
+    if (viewHeap == NULL || samplerHeap == NULL) {
+        static bool logged = false;
+        if (!logged) {
+            logged = true;
+            SDL_LogError(SDL_LOG_CATEGORY_GPU, "No new GPU descriptor heap: the bound ones are reused");
+        }
+        if (commandBuffer->gpuDescriptorHeaps[0] == NULL || commandBuffer->gpuDescriptorHeaps[1] == NULL) {
+            return; /* (none at all: nothing to bind) */
+        }
+        commandBuffer->gpuDescriptorHeaps[0]->currentDescriptorIndex = 0;
+        commandBuffer->gpuDescriptorHeaps[1]->currentDescriptorIndex = 0;
+        return;
+    }
+
     commandBuffer->gpuDescriptorHeaps[0] = viewHeap;
     commandBuffer->gpuDescriptorHeaps[1] = samplerHeap;
 
@@ -5040,8 +5059,9 @@ static void D3D12_INTERNAL_WriteGPUDescriptors(
     D3D12DescriptorHeap *heap;
     D3D12_CPU_DESCRIPTOR_HANDLE gpuHeapCpuHandle;
 
-    /* Descriptor overflow, acquire new heaps */
-    if (commandBuffer->gpuDescriptorHeaps[heapType]->currentDescriptorIndex >= commandBuffer->gpuDescriptorHeaps[heapType]->maxDescriptors) {
+    /* Descriptor overflow, acquire new heaps (OpenTM2: room for all of them, not only the first: a write that started
+     * near the end ran past it) */
+    if (commandBuffer->gpuDescriptorHeaps[heapType]->currentDescriptorIndex + resourceHandleCount > commandBuffer->gpuDescriptorHeaps[heapType]->maxDescriptors) {
         D3D12_INTERNAL_SetGPUDescriptorHeaps(commandBuffer);
     }
 
@@ -5077,6 +5097,30 @@ static void D3D12_INTERNAL_BindGraphicsResources(
     if (commandBuffer->gpuDescriptorHeaps[0] == NULL) {
         D3D12_INTERNAL_SetGPUDescriptorHeaps(commandBuffer);
     }
+    if (commandBuffer->gpuDescriptorHeaps[0] == NULL || commandBuffer->gpuDescriptorHeaps[1] == NULL) {
+        return; /* (OpenTM2: no heap at all from the driver) */
+    }
+
+    /* (OpenTM2) Room for every table this bind may write, before writing any: new heaps in the middle of it would
+     * leave the tables already set pointing into the old ones. With new heaps, every table is written again. */
+    {
+        Uint32 views = graphicsPipeline->header.num_vertex_samplers + graphicsPipeline->header.num_fragment_samplers +
+                       graphicsPipeline->header.num_vertex_storage_textures + graphicsPipeline->header.num_fragment_storage_textures +
+                       graphicsPipeline->header.num_vertex_storage_buffers + graphicsPipeline->header.num_fragment_storage_buffers;
+        Uint32 samplers = graphicsPipeline->header.num_vertex_samplers + graphicsPipeline->header.num_fragment_samplers;
+        D3D12DescriptorHeap *viewHeap = commandBuffer->gpuDescriptorHeaps[D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV];
+        D3D12DescriptorHeap *samplerHeap = commandBuffer->gpuDescriptorHeaps[D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER];
+        if (viewHeap->currentDescriptorIndex + views > viewHeap->maxDescriptors ||
+            samplerHeap->currentDescriptorIndex + samplers > samplerHeap->maxDescriptors) {
+            D3D12_INTERNAL_SetGPUDescriptorHeaps(commandBuffer);
+            commandBuffer->needVertexSamplerBind = true;
+            commandBuffer->needVertexStorageTextureBind = true;
+            commandBuffer->needVertexStorageBufferBind = true;
+            commandBuffer->needFragmentSamplerBind = true;
+            commandBuffer->needFragmentStorageTextureBind = true;
+            commandBuffer->needFragmentStorageBufferBind = true;
+        }
+    }
 
     D3D12_CPU_DESCRIPTOR_HANDLE cpuHandles[MAX_TEXTURE_SAMPLERS_PER_STAGE];
     D3D12_GPU_DESCRIPTOR_HANDLE gpuDescriptorHandle;
