-        uint colorIdx = (word16 >> (subPixel * indexShift)) & indexMask;
-        ivec2 clutBase = ivec2((clut % 64u) * 16u, clut / 64u);
-        texColor = fetchVram(clutBase + ivec2(colorIdx, 0));
+    } else {
+        texColor = texelColor(resolveTexel());
+        // A precise (3D) polygon magnified: a cut-out's edge (a tire's round side, a fence) follows the texels'
+        // see-through ones in whole texels, steps several pixels big when upscaled. Whether a pixel is seen through
+        // is decided from the four texels around it (their coverage, as a bilinear filter's, at a half), so the
+        // edge runs smoothly between texel middles; its color stays a texel's own (the nearest kept one).
+        vec2 texelStep = vec2(abs(dFdx(rawUV.x)), abs(dFdy(rawUV.y)));
+        if (uvBounds != uvec4(0u) && max(texelStep.x, texelStep.y) < 0.75) {
+            vec2 q = rawUV - 0.5 * texelStep + 1.0 / 512.0 - 0.5;
+            vec2 b = floor(q), f = q - b;
+            vec4 c00 = texelColor(boundTexel(b));
+            vec4 c10 = texelColor(boundTexel(b + vec2(1, 0)));
+            vec4 c01 = texelColor(boundTexel(b + vec2(0, 1)));
+            vec4 c11 = texelColor(boundTexel(b + vec2(1, 1)));
+            float w00 = (1.0 - f.x) * (1.0 - f.y), w10 = f.x * (1.0 - f.y), w01 = (1.0 - f.x) * f.y, w11 = f.x * f.y;
+            bool k00 = c00 != vec4(0), k10 = c10 != vec4(0), k01 = c01 != vec4(0), k11 = c11 != vec4(0);
+            float cover = (k00 ? w00 : 0.0) + (k10 ? w10 : 0.0) + (k01 ? w01 : 0.0) + (k11 ? w11 : 0.0);
+            if (cover < 0.5) {
+                texColor = vec4(0);
+            } else if (texColor == vec4(0)) { // kept, its nearest texel see-through: the nearest kept one's color
+                float best = -1.0;
+                if (k00 && w00 > best) { best = w00; texColor = c00; }
+                if (k10 && w10 > best) { best = w10; texColor = c10; }
+                if (k01 && w01 > best) { best = w01; texColor = c01; }
+                if (k11 && w11 > best) { best = w11; texColor = c11; }
+            }
+        }
     }
