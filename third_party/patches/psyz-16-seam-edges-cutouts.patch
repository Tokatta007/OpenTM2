diff --git a/psyz/src/platform/sdl3_gpu.c b/psyz/src/platform/sdl3_gpu.c
index f0359a2..4f6d1fe 100644
--- a/psyz/src/platform/sdl3_gpu.c
+++ b/psyz/src/platform/sdl3_gpu.c
@@ -1535,22 +1535,36 @@ static void PreciseApply(Vertex* v, int n, int semi) {
         v0 = v[i].v < v0 ? v[i].v : v0;
         v1 = v[i].v > v1 ? v[i].v : v1;
     }
-    // an opaque polygon a little bigger (0.3 of a PS1 pixel out from its middle): two meshes meeting at an edge
-    // (a tire's tread and its side) were glued by the PS1's whole pixels; at subpixel places they can miss each
-    // other by a hair, the background seen through. A see-through polygon stays as it is (no double blend).
+    // an opaque polygon a little bigger (every edge 0.3 of a PS1 pixel out): two meshes meeting at an edge (a
+    // tire's tread and its side) were glued by the PS1's whole pixels; at subpixel places they can miss each
+    // other by a hair, the background seen through. The outline is offset (the corners along their bisectors),
+    // so a long thin polygon grows across too. A see-through polygon stays as it is (no double blend).
     if (!semi && n >= 3) {
-        float cx = 0, cy = 0;
-        for (int i = 0; i < n; i++) {
-            cx += v[i].x;
-            cy += v[i].y;
-        }
-        cx /= n;
-        cy /= n;
-        for (int i = 0; i < n; i++) {
-            float dx = v[i].x - cx, dy = v[i].y - cy, d = sqrtf(dx * dx + dy * dy);
-            if (d > 0.5f) {
-                v[i].x += dx / d * 0.3f;
-                v[i].y += dy / d * 0.3f;
+        static const int quad_ring[4] = {0, 1, 3, 2}, tri_ring[3] = {0, 1, 2}; // (a quad's corners: Z order)
+        const int* ring = n == 4 ? quad_ring : tri_ring;
+        int m = n == 4 ? 4 : 3;
+        float px[4], py[4], nx[4], ny[4], area = 0;
+        for (int i = 0; i < m; i++) {
+            px[i] = v[ring[i]].x;
+            py[i] = v[ring[i]].y;
+        }
+        for (int i = 0; i < m; i++) {
+            area += px[i] * py[(i + 1) % m] - px[(i + 1) % m] * py[i];
+        }
+        if (area > 1e-3f || area < -1e-3f) {
+            float s = area > 0 ? 1.0f : -1.0f;
+            for (int i = 0; i < m; i++) { // each edge's outward normal
+                float ex = px[(i + 1) % m] - px[i], ey = py[(i + 1) % m] - py[i];
+                float len = sqrtf(ex * ex + ey * ey);
+                nx[i] = len < 1e-4f ? 0 : s * ey / len;
+                ny[i] = len < 1e-4f ? 0 : -s * ex / len;
+            }
+            for (int i = 0; i < m; i++) {
+                int e0 = (i + m - 1) % m;
+                float d = 1 + nx[e0] * nx[i] + ny[e0] * ny[i];
+                if (d < 0.5f) d = 0.5f; // (a sharp corner: its miter capped at twice)
+                v[ring[i]].x = px[i] + (nx[e0] + nx[i]) * 0.3f / d;
+                v[ring[i]].y = py[i] + (ny[e0] + ny[i]) * 0.3f / d;
             }
         }
     }
