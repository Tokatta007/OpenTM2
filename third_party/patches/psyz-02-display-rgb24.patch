+/**
+ * @brief Show an RGB888 image instead of the display area (24-bit display)
+ *
+ * The renderer does not decode the PS1's 24-bit display mode; the caller
+ * decodes the displayed VRAM area and passes the picture here before each
+ * present. It is shown, scaled like the normal display, until called with
+ * NULL.
+ *
+ * @param rgb RGB888 pixels (copied), or NULL to show VRAM again
+ * @param w Width in pixels
+ * @param h Height in pixels
+ */
+void Psyz_VideoSetDisplayRGB24(const unsigned char* rgb, int w, int h);
+
