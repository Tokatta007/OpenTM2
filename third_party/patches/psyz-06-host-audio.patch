@@ -40,6 +40,27 @@
     u8 initialized;
 } spu;
 
+// host volume per voice (Psyz_SpuSetVoiceGain), 32768 = unchanged
+static int voice_gain[PSYZ_SPU_NUM_VOICES];
+static int voice_gain_set;
+
+void Psyz_SpuCdFlush(void) {
+    spu.cd_ring_read = 0;
+    spu.cd_ring_count = 0;
+}
+
+void Psyz_SpuSetVoiceGain(int voice, int gain) {
+    gain = gain < 0 ? 0 : gain > 32768 ? 32768 : gain;
+    if (!voice_gain_set) {
+        for (int v = 0; v < PSYZ_SPU_NUM_VOICES; v++)
+            voice_gain[v] = 32768;
+        voice_gain_set = 1;
+    }
+    for (int v = 0; v < PSYZ_SPU_NUM_VOICES; v++)
+        if (voice < 0 || v == voice)
+            voice_gain[v] = gain;
+}
+
 u8* Psyz_SpuGetRam(void) { return spu.ram; }
 
