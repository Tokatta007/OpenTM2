 /**
+ * @brief Host volume for one voice, on top of everything the game sets
+ *
+ * Scales the voice (and what it sends to reverb) as it is mixed; CD audio
+ * is not affected. For host-side volume controls, e.g. music and effects.
+ *
+ * @param voice 0-23, or -1 for every voice
+ * @param gain 0 (silent) to 32768 (unchanged, the default)
+ */
+void Psyz_SpuSetVoiceGain(int voice, int gain);
+
+/**
+ * @brief Drop the CD audio already pulled but not yet played
+ *
+ * The SPU reads CD audio ahead (up to CD_RING_FRAMES frames). When the
+ * source jumps to a new position, call this (with the audio lock held) so
+ * the old position's last frames are not heard first.
+ */
+void Psyz_SpuCdFlush(void);
