+ * @param x, y, w, h The VRAM rectangle, in native pixels
+ * @param rgb RGB888 pixels of the picture
+ * @param pw, ph Its size
+ */
+int Psyz_VideoLoadImageHD(int x, int y, int w, int h, const unsigned char* rgb, int pw, int ph);
