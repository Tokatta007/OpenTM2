+// a larger picture over a rectangle of the upscaled VRAM (Psyz_VideoLoadImageHD)
+static SDL_GPUTexture* hd_tex;
+static SDL_GPUTransferBuffer* hd_xfer;
+static int hd_w, hd_h;
+
+int Psyz_VideoLoadImageHD(int x, int y, int w, int h, const unsigned char* rgb, int pw, int ph) {
+    if (internal_res <= 1 || !scaled_vram_render || !rgb || pw <= 0 || ph <= 0 || w <= 0 || h <= 0 ||
+        x < 0 || y < 0 || x + w > VRAM_W || y + h > VRAM_H) {
+        return 0;
+    }
+    if (!hd_tex || hd_w != pw || hd_h != ph) {
+        if (hd_tex) {
+            SDL_ReleaseGPUTexture(device, hd_tex);
+        }
+        if (hd_xfer) {
+            SDL_ReleaseGPUTransferBuffer(device, hd_xfer);
+        }
+        const SDL_GPUTextureCreateInfo tex_info = {
+            .type = SDL_GPU_TEXTURETYPE_2D,
+            .format = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM,
+            .usage = SDL_GPU_TEXTUREUSAGE_SAMPLER,
+            .width = (Uint32)pw,
+            .height = (Uint32)ph,
+            .layer_count_or_depth = 1,
+            .num_levels = 1,
+        };
+        const SDL_GPUTransferBufferCreateInfo xfer_info = {
+            .usage = SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD,
+            .size = (Uint32)(pw * ph * 4),
+        };
+        hd_tex = SDL_CreateGPUTexture(device, &tex_info);
+        hd_xfer = SDL_CreateGPUTransferBuffer(device, &xfer_info);
+        if (!hd_tex || !hd_xfer) {
+            ERRORF("HD image texture: %s", SDL_GetError());
+            hd_tex = NULL;
+            hd_xfer = NULL;
+            return 0;
+        }
+        hd_w = pw;
+        hd_h = ph;
+    }
+    SDL_GPUCommandBuffer* cmd = AcquireCmd();
+    if (!cmd) {
+        return 0;
+    }
+    u8* map = SDL_MapGPUTransferBuffer(device, hd_xfer, true);
+    if (!map) {
+        return 0;
+    }
+    for (size_t i = 0; i < (size_t)pw * ph; i++) {
+        map[i * 4 + 0] = rgb[i * 3 + 0];
+        map[i * 4 + 1] = rgb[i * 3 + 1];
+        map[i * 4 + 2] = rgb[i * 3 + 2];
+        map[i * 4 + 3] = 255;
+    }
+    SDL_UnmapGPUTransferBuffer(device, hd_xfer);
+    SDL_GPUCopyPass* copy = SDL_BeginGPUCopyPass(cmd);
+    const SDL_GPUTextureTransferInfo src = {
+        .transfer_buffer = hd_xfer,
+        .pixels_per_row = (Uint32)pw,
+        .rows_per_layer = (Uint32)ph,
+    };
+    const SDL_GPUTextureRegion dst = {.texture = hd_tex, .w = (Uint32)pw, .h = (Uint32)ph, .d = 1};
+    SDL_UploadToGPUTexture(copy, &src, &dst, true);
+    SDL_EndGPUCopyPass(copy);
+    const SDL_GPUBlitInfo blit = {
+        .source = {.texture = hd_tex, .w = (Uint32)pw, .h = (Uint32)ph},
+        .destination = {.texture = scaled_vram_render,
+                        .x = (Uint32)(x * internal_res),
+                        .y = (Uint32)(y * internal_res),
+                        .w = (Uint32)(w * internal_res),
+                        .h = (Uint32)(h * internal_res)},
+        .load_op = SDL_GPU_LOADOP_LOAD,
+        .filter = SDL_GPU_FILTER_LINEAR,
+    };
+    SDL_BlitGPUTexture(cmd, &blit);
+    return 1;
+}
