+ * @param rgb RGB888 pixels (copied), or NULL for no overlay
+ * @param w Width in pixels
+ * @param h Height in pixels
+ * @param rects n rectangles, 4 ints each: x, y, width, height
+ * @param n How many (at most 64)
+ */
+void Psyz_VideoSetOverlay(const unsigned char* rgb, int w, int h, const int* rects, int n);
