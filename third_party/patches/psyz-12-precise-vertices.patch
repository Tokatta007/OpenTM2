+// Psyz_GpuPushPrecise: one entry per polygon command, in GP0 order (the
+// caller flushes the GP0 queue long before this many polygons wait in it)
+#define PRECISE_FIFO_SIZE 16384
+static struct {
+    int n;
+    float xyw[12];
+} precise_fifo[PRECISE_FIFO_SIZE];
+static unsigned precise_head, precise_tail; // pushed, taken
+static bool precise_on = false;
+void Psyz_GpuPushPrecise(const float* xyw, int n) {
+    precise_on = true;
+    if (precise_head - precise_tail >= PRECISE_FIFO_SIZE) {
+        WARNF("precise vertex queue full");
+        return;
+    }
+    int k = precise_head++ % PRECISE_FIFO_SIZE;
+    precise_fifo[k].n = xyw && n >= 3 && n <= 4 ? n : 0;
+    if (precise_fifo[k].n) {
+        memcpy(precise_fifo[k].xyw, xyw, sizeof(float) * 3 * (size_t)n);
+    }
+}
+static void PreciseApply(Vertex* v, int n) {
+    if (!precise_on || precise_tail == precise_head) {
+        return;
+    }
+    int k = precise_tail++ % PRECISE_FIFO_SIZE;
+    if (precise_fifo[k].n != n) {
+        return;
+    }
+    const float* p = precise_fifo[k].xyw;
+    int u0 = 255, v0 = 255, u1 = 0, v1 = 0;
+    for (int i = 0; i < n; i++) {
+        v[i].x = p[i * 3];
+        v[i].y = p[i * 3 + 1];
+        v[i].w = p[i * 3 + 2];
+        u0 = v[i].u < u0 ? v[i].u : u0;
+        u1 = v[i].u > u1 ? v[i].u : u1;
+        v0 = v[i].v < v0 ? v[i].v : v0;
+        v1 = v[i].v > v1 ? v[i].v : v1;
+    }
+    // the texels the polygon spans: its far edges' are not drawn (as the PS1)
+    if (u1 > u0) u1--;
+    if (v1 > v0) v1--;
+    for (int i = 0; i < n; i++) {
+        v[i].uvb[0] = (unsigned char)u0;
+        v[i].uvb[1] = (unsigned char)v0;
+        v[i].uvb[2] = (unsigned char)u1;
+        v[i].uvb[3] = (unsigned char)v1;
+    }
+    precise_applied = true;
+}
+
