new file mode 100644
index 0000000..4e58a7a
--- /dev/null
+++ b/psyz/src/platform/shaders/overlay.frag.glsl
@@ -0,0 +1,11 @@
+#version 450
+
+// (OpenTM2) the blended overlay's texels: alpha 0 where the picture is pure
+// black (see-through), 1 elsewhere; blended over the frame
+layout(location = 0) in vec2 uv;
+
+layout(location = 0) out vec4 FragColor;
+
+layout(set = 2, binding = 0) uniform sampler2D overlayTex;
+
+void main() { FragColor = texture(overlayTex, uv); }
diff --git b/psyz/src/platform/shaders/overlay.vert.glsl b/psyz/src/platform/shaders/overlay.vert.glsl
new file mode 100644
index 0000000..b7c0431
--- /dev/null
+++ b/psyz/src/platform/shaders/overlay.vert.glsl
@@ -0,0 +1,16 @@
+#version 450
+
+// (OpenTM2) the blended overlay: one rectangle of the overlay picture, drawn
+// as a 4-vertex strip with no vertex buffer (Psyz_VideoSetOverlayBlend)
+layout(set = 1, binding = 0) uniform UBO {
+    vec4 dst; // the window's rectangle in NDC: x0, y0, x1, y1
+    vec4 src; // the overlay's rectangle in texture coordinates: u0, v0, u1, v1
+};
+
+layout(location = 0) out vec2 uv;
+
+void main() {
+    vec2 c = vec2(float(gl_VertexIndex & 1), float((gl_VertexIndex >> 1) & 1));
+    gl_Position = vec4(mix(dst.x, dst.z, c.x), mix(dst.y, dst.w, c.y), 0.0, 1.0);
+    uv = vec2(mix(src.x, src.z, c.x), mix(src.y, src.w, c.y));
+}
