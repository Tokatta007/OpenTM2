+/**
+ * @brief Play a voice's sample from a bank of the host's instead of SPU RAM
+ *
+ * For sounds the game never loaded (a host's own samples): from the voice's
+ * next key-on it decodes from `ram`, PSYZ_SPU_RAM_SIZE bytes of SPU ADPCM
+ * blocks laid out as SPU RAM (their loop flags as the hardware reads them),
+ * starting at byte `start` (a multiple of 16), and its pitch register is
+ * scaled by `pitch_scale` (4096 = unchanged; the result capped at 0x3FFF).
+ * `ram` NULL: SPU RAM again, unscaled. Call with the audio lock held, before
+ * the key-on is written. The bank must stay valid while the voice plays.
+ *
+ * @param voice 0..PSYZ_SPU_ALL_VOICES-1
+ */
+void Psyz_SpuSetVoiceBank(
+    int voice, const unsigned char* ram, unsigned int start, int pitch_scale);
+
+/**
+ * @brief Change the pitch scale of a voice playing from a host's bank
+ *
+ * As Psyz_SpuSetVoiceBank's `pitch_scale`, now, for the sound it plays
+ * (nothing for a voice playing from SPU RAM). With the audio lock held.
+ */
+void Psyz_SpuSetVoicePitchScale(int voice, int pitch_scale);
+
