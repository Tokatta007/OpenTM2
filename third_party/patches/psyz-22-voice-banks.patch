@@ -71,6 +71,31 @@ void Psyz_SpuSetVoiceGain(int voice, int gain) {
 
 u8* Psyz_SpuGetRam(void) { return spu.ram; }
 
+// a host's bank per voice (Psyz_SpuSetVoiceBank): set for its next key-on,
+// in use from that key-on until the next one without a bank
+static struct {
+    const u8* ram;      // set: the next key-on's
+    unsigned start;
+    int pitch_scale;
+    const u8* playing;  // the bank the voice decodes from now, NULL SPU RAM
+    int playing_scale;
+} voice_bank[PSYZ_SPU_ALL_VOICES];
+
+void Psyz_SpuSetVoiceBank(
+    int voice, const unsigned char* ram, unsigned int start, int pitch_scale) {
+    if (voice < 0 || voice >= PSYZ_SPU_ALL_VOICES)
+        return;
+    voice_bank[voice].ram = ram;
+    voice_bank[voice].start = start & (PSYZ_SPU_RAM_SIZE - 16);
+    voice_bank[voice].pitch_scale = pitch_scale > 0 ? pitch_scale : 4096;
+}
+
+void Psyz_SpuSetVoicePitchScale(int voice, int pitch_scale) {
+    if (voice < 0 || voice >= PSYZ_SPU_ALL_VOICES || !voice_bank[voice].playing)
+        return;
+    voice_bank[voice].playing_scale = pitch_scale > 0 ? pitch_scale : 4096;
+}
