+/* (OpenTM2) The picture onto the window at any size without crawling edges
+ * (OpenTM2 issue 44: a 1680-line picture into 480 lines, nearest, dropped lines
+ * unevenly; 480 into 1080, nearest, made rows of 2 and 3). A whole multiple
+ * stays nearest (pixel-sharp). Smaller: halved smoothly (each 2:1 linear step
+ * averages 2x2) while more than twice the size, then linear. Larger by an
+ * uneven factor: the largest whole multiple nearest, then linear (sharp
+ * bilinear). Scratch textures kept per step, made again when the size changes. */
+#define SCALE_STEPS 6
+static SDL_GPUTexture* scale_tex[SCALE_STEPS];
+static Uint32 scale_tw[SCALE_STEPS], scale_th[SCALE_STEPS];
+static SDL_GPUTexture* ScaleTemp(int i, Uint32 w, Uint32 h) {
+    if (scale_tex[i] && scale_tw[i] == w && scale_th[i] == h) {
+        return scale_tex[i];
+    }
+    if (scale_tex[i]) {
+        SDL_ReleaseGPUTexture(device, scale_tex[i]);
+        scale_tex[i] = NULL;
+    }
+    const SDL_GPUTextureCreateInfo info = {
+        .type = SDL_GPU_TEXTURETYPE_2D,
+        .format = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM,
+        .usage =
+            SDL_GPU_TEXTUREUSAGE_COLOR_TARGET | SDL_GPU_TEXTUREUSAGE_SAMPLER,
+        .width = w,
+        .height = h,
+        .layer_count_or_depth = 1,
+        .num_levels = 1,
+    };
+    scale_tex[i] = SDL_CreateGPUTexture(device, &info);
+    scale_tw[i] = w;
+    scale_th[i] = h;
+    return scale_tex[i];
+}
+static Uint32 ScaleStep(Uint32 from, Uint32 to) { return from / 2 >= to ? from / 2 : to; }
+/* src onto dst (the window's area): returns the region to blit last and its
+ * filter; the steps before it done here */
+static SDL_GPUBlitRegion ScaleSteps(
+    SDL_GPUCommandBuffer* cmd, SDL_GPUBlitRegion src, Uint32 dw, Uint32 dh,
+    SDL_GPUFilter* filter) {
+    *filter = SDL_GPU_FILTER_NEAREST;
+    if (!dw || !dh || !src.w || !src.h) {
+        return src;
+    }
+    if ((dw % src.w == 0 && dh % src.h == 0) || (dw == src.w && dh == src.h)) {
+        return src; /* a whole multiple (or the same): sharp */
+    }
+    *filter = SDL_GPU_FILTER_LINEAR;
+    int i = 0;
+    if (src.w > dw || src.h > dh) { /* smaller: halved while over twice */
+        while (i < SCALE_STEPS && (src.w > dw * 2 || src.h > dh * 2)) {
+            Uint32 w = ScaleStep(src.w, dw), h = ScaleStep(src.h, dh);
+            SDL_GPUTexture* t = ScaleTemp(i, w, h);
+            if (!t) {
+                break;
+            }
+            const SDL_GPUBlitInfo half = {
+                .source = src,
+                .destination = {.texture = t, .x = 0, .y = 0, .w = w, .h = h},
+                .load_op = SDL_GPU_LOADOP_DONT_CARE,
+                .filter = SDL_GPU_FILTER_LINEAR,
+            };
+            SDL_BlitGPUTexture(cmd, &half);
+            src = (SDL_GPUBlitRegion){.texture = t, .x = 0, .y = 0, .w = w, .h = h};
+            i++;
+        }
+        return src;
+    }
+    Uint32 k = dh / src.h < dw / src.w ? dh / src.h : dw / src.w; /* larger: the whole multiple first */
+    if (k >= 2) {
+        SDL_GPUTexture* t = ScaleTemp(0, src.w * k, src.h * k);
+        if (t) {
+            const SDL_GPUBlitInfo up = {
+                .source = src,
+                .destination = {.texture = t, .x = 0, .y = 0, .w = src.w * k, .h = src.h * k},
+                .load_op = SDL_GPU_LOADOP_DONT_CARE,
+                .filter = SDL_GPU_FILTER_NEAREST,
+            };
+            SDL_BlitGPUTexture(cmd, &up);
+            src = (SDL_GPUBlitRegion){.texture = t, .x = 0, .y = 0, .w = src.w * k, .h = src.h * k};
+        }
+    }
+    return src;
+}
