 /**
+ * @brief (OpenTM2) Rectangles of the overlay's picture that darken the frame
+ *
+ * After Psyz_VideoSetOverlayBlend (added to its rectangles): as those, but the
+ * pure black pixels darken the frame by half instead of being see-through
+ * (a menu over a running game, as a paused one's darkened picture). The SDL
+ * GPU renderer only.
+ *
+ * @param rects n rectangles, 4 ints each: x, y, width, height
+ * @param n How many (with the blended ones, at most 16)
+ */
+void Psyz_VideoSetOverlayDim(const int* rects, int n);
+
+/**
  * @brief Put a larger picture where an image was just loaded into VRAM
  *
  * For sharper pictures than the game's: after LoadImage put the native image
diff --git a/psyz/src/platform/sdl3_gpu.c b/psyz/src/platform/sdl3_gpu.c
--- a/psyz/src/platform/sdl3_gpu.c
+++ b/psyz/src/platform/sdl3_gpu.c
@@ -1123,6 +1123,13 @@
                     if (i >= ov_n && !p[3]) {
                         continue; // (a blended one's see-through pixel)
                     }
+                    if (i >= ov_n && p[3] < 255) { // (a darkening one's black: the frame by half)
+                        for (int c = 0; c < 3; c++) {
+                            u8* q = &rgb[((size_t)y * w + x) * 3 + c];
+                            *q = (u8)((*q * (255 - p[3]) + p[c] * p[3]) / 255);
+                        }
+                        break;
+                    }
                     rgb[((size_t)y * w + x) * 3 + 0] = p[0];
                     rgb[((size_t)y * w + x) * 3 + 1] = p[1];
                     rgb[((size_t)y * w + x) * 3 + 2] = p[2];
@@ -1151,6 +1158,26 @@
             }
         }
     }
+    ov_dirty = 1;
+}
+
+void Psyz_VideoSetOverlayDim(const int* rects, int n) {
+    if (!ov_pixels || !rects || n <= 0) {
+        return;
+    }
+    for (int i = 0; i < n && ov_bn < OVERLAY_BLEND_RECTS; i++) {
+        const int* r = rects + 4 * i;
+        if (r[2] <= 0 || r[3] <= 0 || r[0] < 0 || r[1] < 0 || r[0] + r[2] > ov_w || r[1] + r[3] > ov_h) {
+            continue;
+        }
+        memcpy(ov_brects[ov_bn++], r, 4 * sizeof(int));
+        for (int y = r[1]; y < r[1] + r[3]; y++) { // pure black: the frame darkened by half
+            u8* p = ov_pixels + ((size_t)y * ov_w + r[0]) * 4;
+            for (int x = 0; x < r[2]; x++, p += 4) {
+                p[3] = (p[0] | p[1] | p[2]) ? 255 : 128;
+            }
+        }
+    }
     ov_dirty = 1;
 }
 
