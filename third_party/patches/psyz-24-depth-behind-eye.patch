diff --git a/psyz/src/platform/shaders/psx.vert.glsl b/psyz/src/platform/shaders/psx.vert.glsl
index 29aff77..1569074 100644
--- a/psyz/src/platform/shaders/psx.vert.glsl
+++ b/psyz/src/platform/shaders/psx.vert.glsl
@@ -33,7 +33,12 @@ void main() {
     // so VRAM row 0 lands on texture row 0, like the GL FBO convention.
     // w: the hardware interpolates UV and color perspective-correctly
     // depth (PSY-Z's depth buffer): z/w = (1/64)/(w + bias), nearer is greater (w is the GTE's depth, at least 1/64)
-    gl_Position = vec4(x * w, -y * w, w / max(w + zbias, 1.0 / 64.0) / 64.0, w);
+    // A corner behind the eye (w <= 0) takes z = 1/64, the unbiased z of every corner: the clipper then cuts the
+    // polygon only near the eye (z <= w: w at least 1/64). With z = w there the depth along its edges fell below 0
+    // just past the corner in front, and nearly all of the polygon was cut away (a ground tile reaching under the
+    // camera vanished: New York's roof, the dark triangles under the car and at the screen's bottom)
+    float depthZ = w > 0.0 ? w / max(w + zbias, 1.0 / 64.0) / 64.0 : 1.0 / 64.0;
+    gl_Position = vec4(x * w, -y * w, depthZ, w);
     // gouraud colors
     vertexColor = color;
     // select the right texture coords based on the tpage
