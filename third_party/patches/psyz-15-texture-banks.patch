+// texture banks: bank b's layer (grown in steps of 8 layers, the old ones copied over)
+static bool BankEnsure(unsigned b) {
+    if (b < bank_layers) {
+        return true;
+    }
+    unsigned layers = (b + 8) & ~7u;
+    if (layers > BANK_MAX) {
+        layers = BANK_MAX;
+    }
+    const SDL_GPUTextureCreateInfo info = {
+        .type = SDL_GPU_TEXTURETYPE_2D_ARRAY,
+        .format = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM,
+        .usage = SDL_GPU_TEXTUREUSAGE_SAMPLER,
+        .width = VRAM_W,
+        .height = VRAM_H,
+        .layer_count_or_depth = layers,
+        .num_levels = 1,
+    };
+    SDL_GPUTexture* tex = SDL_CreateGPUTexture(device, &info);
+    if (!tex) {
+        ERRORF("texture banks: %s", SDL_GetError());
+        return false;
+    }
+    SDL_GPUCommandBuffer* cmd = AcquireCmd();
+    if (!cmd) {
+        SDL_ReleaseGPUTexture(device, tex);
+        return false;
+    }
+    if (bank_layers > 0) {
+        SDL_GPUCopyPass* copy = SDL_BeginGPUCopyPass(cmd);
+        for (unsigned l = 1; l < bank_layers; l++) {
+            const SDL_GPUTextureLocation src = {.texture = bank_tex, .layer = l};
+            const SDL_GPUTextureLocation dst = {.texture = tex, .layer = l};
+            SDL_CopyGPUTextureToTexture(copy, &src, &dst, VRAM_W, VRAM_H, 1, false);
+        }
+        SDL_EndGPUCopyPass(copy);
+    }
+    SubmitCmdAndWait();
+    SDL_ReleaseGPUTexture(device, bank_tex);
+    bank_tex = tex;
+    bank_layers = layers;
+    return true;
+}
+
+void Psyz_VideoBankLoadImage(int bank, int x, int y, int w, int h, const unsigned short* pix) {
+    PS1_RECT r = {(short)x, (short)y, (short)w, (short)h}, *rect = &r;
+    u_long* p = (u_long*)pix;
+    if (bank <= 0) {
+        Draw_LoadImage(rect, p);
+        return;
+    }
+    if (bank >= BANK_MAX || rect->w <= 0 || rect->h <= 0 || rect->x < 0 || rect->y < 0 ||
+        rect->x + rect->w > VRAM_W || rect->y + rect->h > VRAM_H) {
+        return; // (a bank past the ones kept: its textures are not shown)
+    }
+    if (!sdl3_window && !InitPlatform()) {
+        return;
+    }
+    Draw_FlushBuffer(); // the primitives before it see the bank as it was
+    if (!BankEnsure((unsigned)bank)) {
+        return;
+    }
+    if (!bank_cpu[bank] && !(bank_cpu[bank] = SDL_calloc((size_t)VRAM_W * VRAM_H, 2))) {
+        return;
+    }
+    const u16* src16 = (const u16*)p;
+    for (int j = 0; j < rect->h; j++) {
+        memcpy(&bank_cpu[bank][(size_t)(rect->y + j) * VRAM_W + rect->x], &src16[(size_t)j * rect->w],
+               (size_t)rect->w * 2);
+    }
+    SDL_GPUCommandBuffer* cmd = AcquireCmd();
+    if (!cmd) {
+        return;
+    }
+    u8* map = SDL_MapGPUTransferBuffer(device, tex_upload_transfer, true);
+    if (!map) {
+        ERRORF("SDL_MapGPUTransferBuffer: %s", SDL_GetError());
+        return;
+    }
+    ConvertRgb5551ToRgba8888(src16, map, (size_t)rect->w * rect->h);
+    SDL_UnmapGPUTransferBuffer(device, tex_upload_transfer);
+    SDL_GPUCopyPass* copy = SDL_BeginGPUCopyPass(cmd);
+    const SDL_GPUTextureTransferInfo src = {
+        .transfer_buffer = tex_upload_transfer,
+        .pixels_per_row = rect->w,
+        .rows_per_layer = rect->h,
+    };
+    const SDL_GPUTextureRegion dst = {
+        .texture = bank_tex,
+        .layer = (Uint32)bank,
+        .x = (Uint32)rect->x,
+        .y = (Uint32)rect->y,
+        .w = rect->w,
+        .h = rect->h,
+        .d = 1,
+    };
+    SDL_UploadToGPUTexture(copy, &src, &dst, false);
+    SDL_EndGPUCopyPass(copy);
+}
+
+void Psyz_VideoBankStoreImage(int bank, int x, int y, int w, int h, unsigned short* pix) {
+    PS1_RECT r = {(short)x, (short)y, (short)w, (short)h}, *rect = &r;
+    u_long* p = (u_long*)pix;
+    if (bank <= 0) {
+        Draw_StoreImage(rect, p);
+        return;
+    }
+    if (bank >= BANK_MAX || rect->w <= 0 || rect->h <= 0 || rect->x < 0 || rect->y < 0 ||
+        rect->x + rect->w > VRAM_W || rect->y + rect->h > VRAM_H) {
+        return;
+    }
+    u16* out = (u16*)p;
+    for (int j = 0; j < rect->h; j++) {
+        if (bank_cpu[bank]) {
+            memcpy(&out[(size_t)j * rect->w], &bank_cpu[bank][(size_t)(rect->y + j) * VRAM_W + rect->x],
+                   (size_t)rect->w * 2);
+        } else {
+            memset(&out[(size_t)j * rect->w], 0, (size_t)rect->w * 2);
+        }
+    }
+}
+
+int Psyz_VideoBanksSupported(void) { return 1; }
